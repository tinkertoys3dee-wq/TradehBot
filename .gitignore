# Python build artifacts
__pycache__/
*.py[cod]
*$py.class

# Bot runtime output -- regenerated on every run, and models/state are
# machine-specific (a cached model trained elsewhere should never be
# treated as authoritative for this deployment).
logs/
models/
state/
*.log
backtest_results*.csv
portfolio_backtest_*.csv

# Local env / secrets. Alpaca credentials come from APCA_API_KEY_ID and
# APCA_API_SECRET_KEY in the environment -- never commit them.
.env
.env.*
venv/
.venv/
